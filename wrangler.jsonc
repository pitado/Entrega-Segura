{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pitou",
  "main": ".open-next/worker.js",
  "keep_vars": true,
  "compatibility_date": "2026-11-09",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "pitou.com.br", "custom_domain": true },
    { "pattern": "www.pitou.com.br", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
