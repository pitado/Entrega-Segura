# Configure como secrets no Worker "pitou". Nunca envie valores reais ao GitHub.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/entrega_segura?sslmode=require
# Opcional: com este código definido, o cadastro de novos estabelecimentos exige o convite.
PITOU_SIGNUP_CODE=
# Opcional: rotas, previsão de chegada e localização automática de endereços.
MAPBOX_ACCESS_TOKEN=cole-o-token-do-mapbox-aqui
# Assinatura pelo Mercado Pago (Seu negócio > Configurações > Credenciais). Use TEST-... para testar.
MERCADOPAGO_ACCESS_TOKEN=
# Assinatura secreta dos webhooks (Suas integrações > Webhooks). URL: https://pitou.com.br/api/billing/webhook
MERCADOPAGO_WEBHOOK_SECRET=
# E-mails com acesso liberado sem pagar (equipe Pitou), separados por vírgula.
PITOU_ADMIN_EMAILS=
# Dias de teste grátis para contas novas (padrão 7; 0 desliga).
PITOU_TRIAL_DAYS=7
